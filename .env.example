# Anthropic — leave unset if you use `ant auth login` (the SDK picks up the profile)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Postgres (required). Local: postgresql://localhost:5432/superx — production: your Railway/Supabase URL
DATABASE_URL=

# Cost/abuse guardrail
MAX_USER_MSGS_PER_DAY=50

# Agent persona
AGENT_NAME=Sam

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=superx-verify
WHATSAPP_API_VERSION=v21.0

# Server
PORT=3000
DB_PATH=superx.db
